# direnv entry point: load the pinned development toolchain from flake.nix.
#
#   direnv allow     run once after cloning, then the shell loads automatically
#   direnv reload    re-evaluate after editing flake.nix or flake.lock
#
# The flake provides Go, gopls, golangci-lint, air and the Tailwind CSS v4
# standalone CLI, so no Node.js or npm is required.
#
# Install nix-direnv (https://github.com/nix-community/nix-direnv) to cache the
# evaluated shell across sessions. Plain direnv works without it; it just
# re-evaluates the flake on every prompt.

# The dev shell replaces PATH and does not ship the `nix` CLI itself, so
# `nix flake update` and `make fmt` would stop working inside the project.
# Remember the nix binary directory before the shell takes over.
if _myops_nix_bin="$(command -v nix)"; then
  _myops_nix_dir="$(dirname "$_myops_nix_bin")"
else
  _myops_nix_dir=/nix/var/nix/profiles/default/bin
fi

use flake

PATH_add "$_myops_nix_dir"
unset _myops_nix_bin _myops_nix_dir
